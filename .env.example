# Copy this file to .env and fill in your values

# Telem API key (all searching and fetching): https://app.telem.ai
TELEM_API_KEY=

# Anthropic API key (Claude Haiku for extraction): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional
# CANON_MODEL=claude-haiku-5-5
# CANON_DB=facts.db

# Demo video voice-over (demo/build.py): one of these, else macOS `say` is used
# OPENAI_API_KEY=            # https://platform.openai.com/api-keys  (voice: OPENAI_TTS_VOICE=sage)
# ELEVENLABS_API_KEY=        # https://elevenlabs.io/app/settings/api-keys  (ELEVENLABS_VOICE_ID=...)
